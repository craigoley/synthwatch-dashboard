{
  "name": "synthwatch-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "gen:types": "pg-to-ts generate -c \"$DATABASE_URL\" -t checks runs run_steps run_metrics incidents -o src/db-types.ts"
  },
  "dependencies": {
    "@vercel/functions": "^2.0.0",
    "next": "15.5.18",
    "pg": "^8.13.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^2.15.0",
    "swr": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.18",
    "eslint-plugin-security": "^4.0.1",
    "pg-to-ts": "^4.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
