# ─────────────────────────────────────────────────────────────────────────────
# SynthWatch dashboard environment
# ─────────────────────────────────────────────────────────────────────────────

# Connection string to the SHARED Azure Postgres Flexible Server that the
# synthwatch runner writes to. The dashboard only ever reads this server-side
# (inside /api/* route handlers). It is NEVER exposed to the browser and is NOT
# required to build the app.
#
#   postgres://<user>:<password>@<host>.postgres.database.azure.com:5432/<db>?sslmode=require
#
# Azure Postgres requires TLS; keep `sslmode=require` in the URL.
#
# ESCALATION (connection exhaustion): the server is a Burstable B1ms with a low
# max-connection ceiling. If the pooled API layer is not enough, enable PgBouncer
# on the Flexible Server and point DATABASE_URL at the pooled port (6432) instead
# of the direct 5432 port.
DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/synthwatch?sslmode=require
