# ─────────────────────────────────────────────────────────────────────────────
# SynthWatch dashboard environment
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the standalone C# API the dashboard reads from. The dashboard has
# no backend of its own — every request goes through src/lib/api-client.ts to
# this URL. Must include the /api path segment.
#
# Set in Vercel (Production + Preview) and, for local dev, in .env.local.
# Because it is NEXT_PUBLIC_*, it is inlined into the client bundle at build time.
NEXT_PUBLIC_API_BASE_URL=https://synthwatch-api.azurewebsites.net/api
